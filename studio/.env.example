# =============================================================================
# FastAPI Studio - exemplo de configuracao
# Copie para .env e ajuste. NUNCA versione o .env real.
# =============================================================================

# ----------------------------------------------------------------------------
# Aplicacao
# ----------------------------------------------------------------------------
STUDIO_ENV=production
STUDIO_DEBUG=false
STUDIO_HOST=0.0.0.0
STUDIO_PORT=8000
STUDIO_LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Seguranca
# ----------------------------------------------------------------------------
# Obrigatorio em producao. Gere com:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
STUDIO_SECRET_KEY=troque-esta-chave-por-uma-aleatoria-de-48-bytes

# Chave usada para cifrar as senhas das conexoes de banco de dados (Fernet/AES).
# Gere com:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Se ficar vazia, e derivada de STUDIO_SECRET_KEY (menos isolada).
STUDIO_ENCRYPTION_KEY=

STUDIO_JWT_ALGORITHM=HS256
STUDIO_ACCESS_TOKEN_MINUTES=60
STUDIO_REFRESH_TOKEN_DAYS=7

# Bootstrap do primeiro administrador (usado apenas quando a tabela de usuarios
# esta vazia, na primeira inicializacao).
STUDIO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
STUDIO_BOOTSTRAP_ADMIN_PASSWORD=TroqueEstaSenha123!
STUDIO_BOOTSTRAP_ADMIN_NAME=Administrador

# Politica de senha
STUDIO_PASSWORD_MIN_LENGTH=10

# ----------------------------------------------------------------------------
# Banco de metadados do Studio (configuracoes, usuarios, endpoints, logs)
# ----------------------------------------------------------------------------
# Desenvolvimento local (padrao): SQLite em ./data/studio.db
STUDIO_DATABASE_URL=sqlite:///./data/studio.db
# Producao no Easypanel (Postgres do servico `db` do compose):
# STUDIO_DATABASE_URL=postgresql+psycopg://studio:studio@db:5432/studio

# ----------------------------------------------------------------------------
# Banco de dados alvo (SQL Server / ERP)
# ----------------------------------------------------------------------------
# Servidor apenas de leitura por padrao. Habilite escrita somente se necessario.
STUDIO_ALLOW_WRITE_OPERATIONS=false

# Driver ODBC usado nas conexoes SQL Server.
# Linux (imagem Docker) -> "ODBC Driver 18 for SQL Server"
# Windows              -> "ODBC Driver 18 for SQL Server"
STUDIO_MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# TTL (segundos) do cache de introspeccao de metadados do banco alvo.
STUDIO_INTROSPECTION_CACHE_TTL=300

# Timeout (segundos) de execucao de uma consulta no banco alvo.
STUDIO_QUERY_TIMEOUT=30

# Numero maximo de linhas retornadas por requisicao (protecao de memoria).
STUDIO_MAX_ROWS=1000

# ----------------------------------------------------------------------------
# Runtime das APIs publicadas
# ----------------------------------------------------------------------------
STUDIO_RUNTIME_PREFIX=/api/v1
STUDIO_RATE_LIMIT_PER_MINUTE=120
STUDIO_CORS_ORIGINS=*

# ----------------------------------------------------------------------------
# Modo avancado (codigo Python personalizado)
# ----------------------------------------------------------------------------
STUDIO_ADVANCED_ENABLED=true
STUDIO_ADVANCED_TIMEOUT_SECONDS=10
STUDIO_ADVANCED_MAX_CODE_BYTES=65536

# ----------------------------------------------------------------------------
# Operacao
# ----------------------------------------------------------------------------
# Executa as migracoes Alembic automaticamente na inicializacao do container.
STUDIO_RUN_MIGRATIONS_ON_STARTUP=true
